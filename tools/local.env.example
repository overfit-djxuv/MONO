# Copy to tools/local.env (git-ignored) and fill in your own values.
DEVICE="YOUR-DEVICE-UDID"          # xcrun devicectl list devices
DEVELOPMENT_TEAM="YOURTEAMID"      # 10 characters, Xcode > Settings > Accounts
BUNDLE_ID_PREFIX="com.yourname"    # app id becomes <prefix>.monoapp; must be unique to you
